<Application
    x:Class="SmartMixer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#202020" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A8A8A8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#202020" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#A8A8A8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#5C5C5C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="Slider">
                <Setter Property="Foreground" Value="{ThemeResource AccentBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
